# Copy to .env for local use. Never commit the real .env file.
# (Flask does not load .env by itself: on Render set these in the dashboard;
#  locally you can simply export them in your terminal - see README.)

# auto = Gemini if GEMINI_API_KEY is set, otherwise local Ollama
AI_PROVIDER=auto
# none | ollama | gemini | openai_compat   (only used if it is fully configured)
AI_FALLBACK_PROVIDER=none

# --- Gemini (public deployment) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Optional backup provider (any OpenAI-compatible API, e.g. Groq) ---
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# --- Local Ollama (defaults shown) ---
# OLLAMA_URL=http://localhost:11434/api/generate
# OLLAMA_MODEL=gemma4:e2b

# --- Limits (defaults shown) ---
# MAX_TEXT_LENGTH=1000
# CACHE_TTL_SECONDS=600
# RATE_LIMIT_PER_MINUTE=20
